@startuml 3.8-download-failover
skinparam handwritten false
skinparam monochrome true
skinparam defaultFontName "Arial"
skinparam shading false

title Client-Side Automated Failover and Mirror Shifting Flow

participant "Transfer Manager\n(client/transfer.py)" as TM
participant "Storage Node 1\n(Primary Target - OFFLINE)" as N1
participant "Storage Node 2\n(Backup Replica - ONLINE)" as N2

TM -> N1 : socket.connect((host, port_7001))
activate N1
N1 --X TM : ConnectionRefusedError / Timeout (Crash Event)
deactivate N1

note over TM #Pink
  Catch Socket Exception within retry loop.
  Suppress traceback and shift pointer.
end note

TM -> TM : Update network connection vector to Replica 2
TM -> N2 : socket.connect((host, port_7002))
activate N2
N2 --> TM : Handshake established (SYN-ACK)
TM <- N2 : Pull block binary byte-stream segments
TM -> TM : Decrypt and finalize asset recovery on disk
deactivate N2
@enduml

