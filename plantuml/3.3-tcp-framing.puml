@startuml 3.3-tcp-framing
skinparam handwritten false
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName "Arial"
skinparam shading false

title Application Binary Stream Serialization Framing Layout (Upload / Data Plane)

rectangle "Application Wire Message Structure (Continuous TCP Byte Stream)" #White {
    
    rectangle "Fixed-Size Protocol Header (9 Bytes Total)" #LightGray {
        [Op Code\n--\n1 Byte\n(ASCII 'U','D','X')] as OpCode
        [Metadata Envelope Length\n--\n4 Bytes\n(Unsigned Int - Big Endian)] as MetaLen
        [Binary Payload Volume Size\n--\n4 Bytes\n(Unsigned Int - Big Endian)] as PayloadSize
    }
    
    rectangle "Variable-Size Payload Body" #White {
        [Metadata Parameter JSON Envelope\n--\nVariable Length\n(UTF-8 Encoded Orchestration String)] as MetaEnv
        [Continuous Raw Binary Payload Stream\n--\nVariable Length\n(Encrypted Ciphertext Octet Stream)] as BinStream
    }
}

note top of OpCode : Operational Context\nIdentifier
note top of MetaLen : Enforces standard Network Byte Order\nEquivalent to htonl() execution mask
note top of MetaEnv : Contains target chunk filename\nand downstream replica routing maps

OpCode -right-> MetaLen
MetaLen -right-> PayloadSize
PayloadSize -right-> MetaEnv
MetaEnv -right-> BinStream
@enduml
