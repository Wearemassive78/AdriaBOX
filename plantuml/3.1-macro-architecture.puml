@startuml 3.1-macro-architecture
skinparam handwritten false
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName "Arial"
skinparam shading false

title AdriaBOX - Macro-Architectural Control Plane and Data Plane Infrastructure Separation

package "Public / Corporate WAN Network" #White {
    component [Tenant Workspaces\n(Client CLI Max / Sam)] as Client
}

package "Metadata Core Plane (Port 5000)" #White {
    component [Metadata Server\n(Control Orchestrator)] as Master
}

package "Decentralized Data Fleet Plane" #White {
    component [Storage Node 1\n(Port 7001)] as N1
    component [Storage Node 2\n(Port 7002)] as N2
    component [Storage Node 12\n(Port 7012)] as N12
}

Client --> Master : "Control Queries & Orchestration Commands\n(HTTP REST / JWT Bearer Token)"
Client ===> N1 : "Low-Level Framed Octet Stream\n(Direct Raw TCP Socket)"
Client ===> N2 : "Low-Level Framed Octet Stream\n(Direct Raw TCP Socket)"
Client ===> N12 : "Low-Level Framed Octet Stream\n(Direct Raw TCP Socket)"

N1 -> N2 : "<<pipeline replication cascade>>"
N2 .down.> N12 : "<<pipeline replication cascade>>"
@enduml

