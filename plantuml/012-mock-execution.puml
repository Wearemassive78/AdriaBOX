@startuml 012-mock-execution
skinparam handwritten false
skinparam monochrome true
skinparam defaultFontName "Arial"
skinparam boxPadding 5
skinparam participantPadding 5

title Mock Execution and Response Interception Flow

box "Pytest Workspace" #White
participant "test_client_login_success" as Test
participant "mock_post : MagicMock" as Mock
end box

box "Client Package Modules" #White
participant "AdriaClient\n(core.py)" as Core
participant "requests.Session\n(Interposed)" as Req
end box

Test -> Mock: set response parameters\n(status_code=200, json={token: 'JWT', role: 'user'})
Test -> Core: login("mario", "password123")
activate Core
Core -> Req: post("http://fake-server:5000/login", json=...)
note over Req: Trap initialized by @patch\nNo socket packets hit the hardware wire
Req -> Mock: redirect execution call
Mock --> Core: yield mock response payload
Core -> Core: extract JWT auth_token
Core -> Core: derive local encryption key
Test <-- Core: return verification map
deactivate Core

Test -> Test: assert client.auth_token == "my-secret-jwt-token"
Test -> Test: assert session header has Bearer prefix
@enduml
