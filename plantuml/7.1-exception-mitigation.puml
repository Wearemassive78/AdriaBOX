@startuml 7.1-exception-mitigation
skinparam handwritten false
skinparam monochrome true
skinparam defaultFontName "Arial"
skinparam shadownding false

actor "Attacker Tenant (sam)" as Sam
boundary "Client CLI Engine" as CLI
control "Flask Master Router" as Master
database "SQLite Metadata" as DB

title AdriaBOX - Prevention of Resource Enumeration (Exception Mapping)

Sam -> CLI : adria download /backup/512MB.zip
activate CLI

CLI -> Master : GET /files/download?path=/backup/512MB.zip\n[JWT Token: Sam]
activate Master

Master -> DB : Query file ownership & metadata
activate DB
DB --> Master : File exists (Owner: max, Scope: private)
deactivate DB

alt Safe Implementation (Need-to-Know)
    Master -> Master : Raise CoreSecurityException\nand map to HTTP 404
    Master --> CLI : HTTP/1.1 404 Not Found (JSON: "File not found")
    CLI --> Sam : ui.print_error("File not found.")
else Naive Implementation (Information Leakage)
    note over Master: LEAKS RESOURCE EXISTENCE
    Master --> CLI : HTTP/1.1 403 Forbidden (JSON: "Unauthorized")
    CLI --> Sam : ui.print_error("Admin privileges or authorization required.")
end
deactivate Master
deactivate CLI
@enduml

